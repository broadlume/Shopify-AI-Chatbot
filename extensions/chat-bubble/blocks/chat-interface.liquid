{{ 'chat.css' | asset_url | stylesheet_tag }}
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<div class="shop-ai-chat-container">
  <div class="shop-ai-chat-bubble" style="background-color: {{ block.settings.chat_bubble_color }}">
    <svg fill="currentColor" width="26" height="26" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
      <polygon points="106.7,53.3 133.3,53.3 160,53.3 186.7,53.3 213.3,53.3 240,53.3 266.7,53.3 293.3,53.3 320,53.3 346.7,53.3 346.7,26.7 320,26.7 293.3,26.7 266.7,26.7 240,26.7 213.3,26.7 186.7,26.7 160,26.7 133.3,26.7 106.7,26.7 80,26.7 53.3,26.7 53.3,53.3 80,53.3"/>
      <rect height="26.7" width="26.7" x="26.7" y="53.3"/>
      <rect height="26.7" width="26.7" x="346.7" y="53.3"/>
      <polygon points="373.3,80 373.3,106.7 373.3,133.3 373.3,160 373.3,186.7 373.3,213.3 373.3,240 373.3,266.7 400,266.7 400,240 400,213.3 400,186.7 400,160 400,133.3 400,106.7 400,80"/>
      <rect height="26.7" width="26.7" x="106.7" y="160"/>
      <rect height="26.7" width="26.7" x="186.7" y="160"/>
      <rect height="26.7" width="26.7" x="266.7" y="160"/>
      <polygon points="26.7,213.3 26.7,186.7 26.7,160 26.7,133.3 26.7,106.7 26.7,80 0,80 0,106.7 0,133.3 0,160 0,186.7 0,213.3 0,240 0,266.7 26.7,266.7 26.7,240"/>
      <rect height="26.7" width="26.7" x="26.7" y="266.7"/>
      <rect height="26.7" width="26.7" x="346.7" y="266.7"/>
      <polygon points="133.3,293.3 106.7,293.3 80,293.3 53.3,293.3 53.3,320 80,320 106.7,320 133.3,320 160,320 160,293.3"/>
      <polygon points="293.3,293.3 266.7,293.3 240,293.3 240,320 266.7,320 293.3,320 320,320 346.7,320 346.7,293.3 320,293.3"/>
      <rect height="26.7" width="26.7" x="160" y="320"/>
      <rect height="26.7" width="26.7" x="213.3" y="320"/>
      <rect height="26.7" width="26.7" x="186.7" y="346.7"/>
    </svg>
  </div>

  <div class="shop-ai-chat-window">
    <div class="shop-ai-chat-header">
      <!-- Avatar -->
      <div class="shop-ai-header-avatar" aria-hidden="true">
        <svg fill="currentColor" width="18" height="18" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
          <polygon points="106.7,53.3 133.3,53.3 160,53.3 186.7,53.3 213.3,53.3 240,53.3 266.7,53.3 293.3,53.3 320,53.3 346.7,53.3 346.7,26.7 320,26.7 293.3,26.7 266.7,26.7 240,26.7 213.3,26.7 186.7,26.7 160,26.7 133.3,26.7 106.7,26.7 80,26.7 53.3,26.7 53.3,53.3 80,53.3"/>
          <rect height="26.7" width="26.7" x="26.7" y="53.3"/>
          <rect height="26.7" width="26.7" x="346.7" y="53.3"/>
          <polygon points="373.3,80 373.3,106.7 373.3,133.3 373.3,160 373.3,186.7 373.3,213.3 373.3,240 373.3,266.7 400,266.7 400,240 400,213.3 400,186.7 400,160 400,133.3 400,106.7 400,80"/>
          <rect height="26.7" width="26.7" x="106.7" y="160"/>
          <rect height="26.7" width="26.7" x="186.7" y="160"/>
          <rect height="26.7" width="26.7" x="266.7" y="160"/>
          <polygon points="26.7,213.3 26.7,186.7 26.7,160 26.7,133.3 26.7,106.7 26.7,80 0,80 0,106.7 0,133.3 0,160 0,186.7 0,213.3 0,240 0,266.7 26.7,266.7 26.7,240"/>
          <rect height="26.7" width="26.7" x="26.7" y="266.7"/>
          <rect height="26.7" width="26.7" x="346.7" y="266.7"/>
          <polygon points="133.3,293.3 106.7,293.3 80,293.3 53.3,293.3 53.3,320 80,320 106.7,320 133.3,320 160,320 160,293.3"/>
          <polygon points="293.3,293.3 266.7,293.3 240,293.3 240,320 266.7,320 293.3,320 320,320 346.7,320 346.7,293.3 320,293.3"/>
          <rect height="26.7" width="26.7" x="160" y="320"/>
          <rect height="26.7" width="26.7" x="213.3" y="320"/>
          <rect height="26.7" width="26.7" x="186.7" y="346.7"/>
        </svg>
      </div>

      <!-- Title + status -->
      <div class="shop-ai-header-info">
        <div class="shop-ai-header-title">{{ 'chat.title' | t }}</div>
        <div class="shop-ai-header-status">
          <span class="shop-ai-status-dot" aria-hidden="true"></span>
          <span class="shop-ai-header-store">{{ shop.name }} &middot; Online</span>
        </div>
      </div>

      <!-- Actions -->
      <div class="shop-ai-header-actions">
        <!-- New conversation (shown only when there are messages) -->
        <button class="shop-ai-new-chat" aria-label="Start new conversation" title="New conversation" style="display:none">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
        </button>
        <button class="shop-ai-theme-toggle" aria-label="Toggle light/dark theme" title="Toggle theme">
          <!-- Sun icon (shown in dark mode) -->
          <svg class="shop-ai-icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg class="shop-ai-icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
        <button class="shop-ai-chat-close" aria-label="Close chat">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="shop-ai-chat-messages">
      <!-- Messages will be added here by JavaScript -->
    </div>

    <div class="shop-ai-chat-input">
      <input type="text" placeholder="{{ 'chat.inputPlaceholder' | t }}">
      <button class="shop-ai-chat-send">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </div>
  </div>
</div>

<script src="{{ 'chat.js' | asset_url }}" defer></script>
<script>
  // Defaults overridden at runtime by app-admin settings (App Admin > Settings)
  // delivered as a 'shop_config' SSE event on every chat request.
  window.shopChatConfig = {
    promptType: "standardAssistant",
    welcomeMessage: "\uD83D\uDC4B Hi there! How can I help you today?",
    appUrl: {{ block.settings.app_url | json }},
    moneyFormat: {{ shop.money_format | json }}
  };
  window.shopId = {{ shop.id }};
  window.shopDomain = {{ shop.permanent_domain | json }};
</script>

{% schema %}
{
  "name": "AI Chat Assistant",
  "target": "body",
  "settings": [
    {
      "type": "color",
      "id": "chat_bubble_color",
      "label": "Chat Bubble Color (fallback)",
      "info": "Initial colour before app settings load. Manage the live colour in App Admin > Settings.",
      "default": "#5046e4"
    },
    {
      "type": "text",
      "id": "app_url",
      "label": "App Backend URL",
      "info": "Required: Enter the full URL of your deployed app backend (e.g. https://your-chatbot.railway.app). For local development use https://localhost:3458.",
      "default": "https://localhost:3458"
    }
  ]
}
{% endschema %}
