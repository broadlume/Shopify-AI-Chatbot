# AI provider
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-haiku-4-5

# Shopify app auth/config
REDIRECT_URL=https://localhost:3458/auth/callback
SHOPIFY_API_KEY=YOUR_APP_CLIENT_ID
SHOPIFY_API_SECRET=YOUR_APP_CLIENT_SECRET
SHOPIFY_APP_URL=https://localhost:3458
SCOPES=unauthenticated_read_product_listings,read_products,read_content,read_product_listings

# Prisma / PostgreSQL
# Local dev: postgresql://youruser@localhost:5432/shopify_chatbot?schema=public
# Production: postgresql://user:password@rds-endpoint:5432/shopify_chatbot
DATABASE_URL="postgresql://localhost:5432/shopify_chatbot?schema=public"

# Optional fallback metafield allowlists
PRODUCT_ALLOWED_METAFIELD_NAMESPACES=$app,specs
VARIANT_ALLOWED_METAFIELD_NAMESPACES=$app,compliance
METAFIELD_VARIANT_LIMIT=25
