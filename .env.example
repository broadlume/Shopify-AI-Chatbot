# ─────────────────────────────────────────────────────────────────────────────
# Shopify AI Chatbot — Environment Variable Reference
# Copy this file to .env for local development.
# NEVER commit .env to git. Use platform secrets (Railway, Fly, Render, etc.)
# for production — do NOT use a .env file in production containers.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Provider (Anthropic Claude) ───────────────────────────────────────────
# Required. Get your key at https://console.anthropic.com
# WARNING: Rotate immediately if this is ever exposed or committed to git.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Which Claude model to use. Defaults to claude-haiku-4-5 (fast + cheap).
# Production options: claude-haiku-4-5 | claude-sonnet-4-5 | claude-opus-4-5
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Shopify App Credentials ───────────────────────────────────────────────────
# Required. Found in your Shopify Partner Dashboard → Apps → API credentials.
SHOPIFY_API_KEY=YOUR_APP_CLIENT_ID
SHOPIFY_API_SECRET=YOUR_APP_CLIENT_SECRET

# Required. The public URL where this app is hosted.
# Local dev: https://localhost:3458 (overwritten automatically by Shopify CLI)
# Production: https://your-app.railway.app  (or your actual host)
SHOPIFY_APP_URL=https://localhost:3458

# Required. Must EXACTLY match the redirect URL registered in shopify.app.toml
# and your Shopify Partner Dashboard → App → URLs → Allowed redirection URLs.
# Local dev: https://localhost:3458/auth/callback
# Production: https://your-app.railway.app/auth/callback
REDIRECT_URL=https://localhost:3458/auth/callback

# Required. Comma-separated Shopify OAuth scopes.
# These must match shopify.app.toml [access_scopes] scopes exactly.
SCOPES=unauthenticated_read_product_listings,read_products,read_content,read_product_listings

# ── Database (Prisma / PostgreSQL) ───────────────────────────────────────────
# Required. Connection string for your PostgreSQL database.
# Local dev example (no password, local socket):
#   postgresql://youruser@localhost:5432/shopify_chatbot?schema=public
# Production example (with credentials, remote host):
#   postgresql://user:password@db.host.example.com:5432/shopify_chatbot?schema=public&sslmode=require
DATABASE_URL="postgresql://localhost:5432/shopify_chatbot?schema=public"

# ── Metafield Access Controls (optional) ─────────────────────────────────────
# Comma-separated metafield namespaces the AI is allowed to read on products.
# $app resolves to the app's own namespace.
PRODUCT_ALLOWED_METAFIELD_NAMESPACES=$app,specs

# Comma-separated metafield namespaces the AI is allowed to read on variants.
VARIANT_ALLOWED_METAFIELD_NAMESPACES=$app,compliance

# Maximum number of variants to fetch metafields for per product.
METAFIELD_VARIANT_LIMIT=25

# ── Optional: Custom Shop Domain ─────────────────────────────────────────────
# Only needed if you use a custom myshopify-compatible domain.
# SHOP_CUSTOM_DOMAIN=your-custom-domain.example.com
